{
  "name": "officia",
  "productName": "OfficiaTech",
  "version": "1.0.0",
  "description": "OfficiaTech — l'assistant administratif tout-en-un : agenda, réunions et PV, rendez-vous, mails, courrier, tâches, rappels et notifications",
  "main": "electron/main.js",
  "author": {
    "name": "TETCHI KOREY JOEL",
    "email": "heliontech97@gmail.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,app \"vite\" \"wait-on tcp:5174 && cross-env OFFICIA_DEV=1 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --x64 --publish never",
    "test": "node --no-warnings --test tests/*.test.js"
  },
  "build": {
    "appId": "com.officiatech.app",
    "productName": "OfficiaTech",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "OfficiaTech-1.00-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "OfficiaTech",
      "artifactName": "OfficiaTech-Setup-1.00.${ext}"
    },
    "copyright": "© 2026 M. TETCHI KOREY JOEL"
  },
  "dependencies": {
    "imapflow": "^2.9.1",
    "mailparser": "^3.12.4",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "chart.js": "^4.6.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.18.0",
    "hoodiecrow-imap": "^2.1.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "smtp-server": "^3.21.1",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}
