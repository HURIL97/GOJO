# Copiez ce fichier en « .env » puis remplacez la valeur ci-dessous.
# Générez un jeton : openssl rand -hex 24
SYNC_TOKEN=remplacez-moi-par-un-long-jeton-secret
# Fuseau horaire des rendez-vous (flux d'agenda) :
TZ=Africa/Abidjan
# Nom du calendrier affiché dans Google Agenda / Outlook :
CALENDAR_NAME=Agenda de la Direction
