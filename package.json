{
  "name": "hospitalis",
  "productName": "Hospitalis",
  "version": "1.0.0",
  "description": "Gestion intégrée Hôtel · Bar · Restaurant — hors-ligne d'abord, synchronisée avec votre VPS",
  "main": "electron/main.js",
  "author": "Hospitalis",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,app \"vite\" \"wait-on tcp:5173 && cross-env HOSPITALIS_DEV=1 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --x64",
    "test": "node --no-warnings --test tests/*.test.js"
  },
  "build": {
    "appId": "com.hospitalis.app",
    "productName": "Hospitalis",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Hospitalis-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Hospitalis",
      "artifactName": "Hospitalis-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "chart.js": "^4.5.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "dependencies": {}
}
